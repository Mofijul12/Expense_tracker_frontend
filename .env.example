# Base URL the frontend prefixes onto every API request.
#
# Leave as /api everywhere:
#   - in development Vite's dev proxy forwards it (see vite.config.js)
#   - in production vercel.json rewrites it to the backend deployment
# Keeping it same-origin is what lets the httpOnly session cookie stay
# first-party. Only point this at the backend's full origin
# (https://your-backend.vercel.app/api) if you also set CROSS_SITE_COOKIE=true
# on the server.
VITE_API_URL=/api

# Where the Vite dev proxy forwards /api requests. Must match PORT in server/.env.
# Development only — not used in a deployed build.
VITE_PROXY_TARGET=http://localhost:4000
